generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id             Int       @id @default(autoincrement())
  name           String    @db.VarChar(255)
  email          String    @unique @db.VarChar(255)
  password       String    @db.VarChar(255)
  role           String    @default("customer") @db.VarChar(50)
  remember_token String?   @db.VarChar(255)
  reset_token    String?   @db.VarChar(255)
  reset_expires  DateTime?
  created_at     DateTime  @default(now())
  customer       Customer?
  orders         Order[]

  @@map("users")
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(255)
  slug        String    @unique @db.VarChar(255)
  description String?   @db.Text
  image_path  String?   @db.Text
  status      Int       @default(1)
  sort_order  Int       @default(0)
  created_at  DateTime  @default(now())
  products    Product[]

  @@map("categories")
}

model Product {
  id                  Int                 @id @default(autoincrement())
  title               String              @db.VarChar(255)
  slug                String              @db.VarChar(255)
  sku                 String?             @db.VarChar(100)
  category            String?             @db.VarChar(100)
  category_id         Int?
  description         String?             @db.Text
  price               Decimal             @default(0.00) @db.Decimal(12, 2)
  stock               Int                 @default(0)
  is_featured         Int                 @default(0)
  image_path          String?             @db.Text
  features            String?             @db.Text
  compatibility       String?             @db.Text
  installation_notes  String?             @db.Text
  created_at          DateTime            @default(now())
  category_rel        Category?           @relation(fields: [category_id], references: [id], onDelete: SetNull)
  images              ProductImage[]
  order_items         OrderItem[]
  inventory_movements InventoryMovement[]

  @@map("products")
}

model ProductImage {
  id         Int     @id @default(autoincrement())
  product_id Int
  image_path String  @db.Text
  product    Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model Customer {
  id            Int      @id @default(autoincrement())
  user_id       Int      @unique
  phone         String?  @db.VarChar(50)
  address       String?  @db.Text
  vehicle_model String?  @db.VarChar(255)
  notes         String?  @db.Text
  created_at    DateTime @default(now())
  user          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("customers")
}

model Order {
  id                 Int         @id @default(autoincrement())
  user_id            Int?
  customer_name      String      @db.VarChar(255)
  phone              String      @db.VarChar(50)
  email              String      @db.VarChar(255)
  address            String?     @db.Text
  district           String?     @db.VarChar(100)
  postal_code        String?     @db.VarChar(50)
  vehicle_model      String      @db.VarChar(255)
  notes              String?     @db.Text
  fulfillment_type   String      @default("pickup") @db.VarChar(50)
  delivery_fee       Decimal     @default(0.00) @db.Decimal(12, 2)
  total_amount       Decimal     @db.Decimal(12, 2)
  payment_method     String      @default("Cash on Delivery") @db.VarChar(100)
  payment_status     String      @default("unpaid") @db.VarChar(50)
  whatsapp_reference String?     @db.VarChar(255)
  status             String      @default("pending") @db.VarChar(50)
  created_at         DateTime    @default(now())
  user               User?       @relation(fields: [user_id], references: [id], onDelete: SetNull)
  items              OrderItem[]

  @@index([status])
  @@index([user_id])
  @@index([created_at])
  @@map("orders")
}

model OrderItem {
  id            Int     @id @default(autoincrement())
  order_id      Int
  product_id    Int
  product_title String  @db.VarChar(255)
  quantity      Int     @default(1)
  price         Decimal @db.Decimal(12, 2)
  order         Order   @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product       Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model Project {
  id              Int            @id @default(autoincrement())
  title           String         @db.VarChar(255)
  slug            String         @unique @db.VarChar(255)
  category        String         @db.VarChar(255)
  description     String?        @db.Text
  featured_image  String?        @db.Text
  before_image    String?        @db.Text
  after_image     String?        @db.Text
  modifications   String?        @db.Text
  installed_parts String?        @db.Text
  customer_notes  String?        @db.Text
  completion_date DateTime?      @db.Date
  project_order   Int            @default(0)
  created_at      DateTime       @default(now())
  images          ProjectImage[]

  @@index([slug])
  @@index([category])
  @@map("projects")
}

model ProjectImage {
  id         Int     @id @default(autoincrement())
  project_id Int
  image_path String  @db.Text
  project    Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@map("project_images")
}

model Service {
  id              Int      @id @default(autoincrement())
  slug            String   @unique @db.VarChar(100)
  title           String   @db.VarChar(255)
  subtitle        String?  @db.VarChar(255)
  description     String?  @db.Text
  features        String?  @db.Text
  hero_banner     String?  @db.VarChar(255)
  pricing         String?  @db.VarChar(255)
  duration        String?  @db.VarChar(100)
  compatibility   String?  @db.Text
  faqs            String?  @db.Text
  seo_title       String?  @db.VarChar(255)
  seo_description String?  @db.Text
  created_at      DateTime @default(now())

  @@index([slug])
  @@map("services")
}

model ServiceImage {
  id           Int      @id @default(autoincrement())
  service_name String   @db.VarChar(100)
  image_path   String   @db.VarChar(255)
  created_at   DateTime @default(now())

  @@map("service_images")
}

model Message {
  id            Int      @id @default(autoincrement())
  name          String   @db.VarChar(255)
  email         String   @db.VarChar(255)
  phone         String?  @db.VarChar(100)
  vehicle       String?  @db.VarChar(255)
  service       String?  @db.VarChar(255)
  subject       String?  @db.VarChar(255)
  message       String   @db.Text
  status        String   @default("unread") @db.VarChar(50)
  reply_content String?  @db.Text
  created_at    DateTime @default(now())

  @@map("messages")
}

model Subscriber {
  id         Int      @id @default(autoincrement())
  email      String   @unique @db.VarChar(255)
  created_at DateTime @default(now())

  @@map("subscribers")
}

model AdminNotification {
  id         Int      @id @default(autoincrement())
  type       String   @db.VarChar(50)
  title      String   @db.VarChar(255)
  message    String   @db.Text
  is_read    Int      @default(0)
  created_at DateTime @default(now())

  @@map("admin_notifications")
}

model InventoryMovement {
  id               Int      @id @default(autoincrement())
  product_id       Int
  quantity_changed Int
  reason           String   @db.VarChar(255)
  user_id          Int?
  created_at       DateTime @default(now())
  product          Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@map("inventory_movements")
}

model Supplier {
  id                Int      @id @default(autoincrement())
  name              String   @db.VarChar(255)
  company           String?  @db.VarChar(255)
  phone             String?  @db.VarChar(100)
  email             String?  @db.VarChar(255)
  products_supplied String?  @db.Text
  created_at        DateTime @default(now())

  @@map("suppliers")
}

model Setting {
  key   String  @id @db.VarChar(100)
  value String? @db.Text

  @@map("settings")
}

model Quotation {
  id               Int             @id @default(autoincrement())
  quotation_number String          @unique @db.VarChar(100)
  customer_name    String          @db.VarChar(255)
  email            String          @db.VarChar(255)
  phone            String?         @db.VarChar(100)
  vehicle_model    String?         @db.VarChar(255)
  total_amount     Decimal         @default(0.00) @db.Decimal(12, 2)
  status           String          @default("sent") @db.VarChar(50)
  created_at       DateTime        @default(now())
  items            QuotationItem[]

  @@map("quotations")
}

model QuotationItem {
  id           Int       @id @default(autoincrement())
  quotation_id Int
  description  String    @db.VarChar(255)
  quantity     Int
  price        Decimal   @db.Decimal(12, 2)
  quotation    Quotation @relation(fields: [quotation_id], references: [id], onDelete: Cascade)

  @@map("quotation_items")
}
